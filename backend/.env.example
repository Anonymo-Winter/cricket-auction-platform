# --- required -----------------------------------------------------------------------------------------------
# MongoDB must run as a replica set (signup uses transactions). See the README for a Docker example.
MONGO_URL=mongodb://USER:PASSWORD@localhost:27017/ipl_auction?authSource=admin&replicaSet=rs0&directConnection=true
JWT_KEY=
JWT_EXPIRES_IN=1d

# --- optional -----------------------------------------------------------------------------------------------
# Where the frontend runs. Used for CORS and for invite / password-reset links.
CLIENT_URL=http://localhost:5173

# open   = anyone can sign up as a team owner
# invite = signup needs an owner invite link created by an admin
SIGNUP_MODE=open

PORT=8080

# Behind a reverse proxy (nginx, a load balancer): the number of proxies in front, so rate limits see real client IPs
# TRUST_PROXY=1

# Switches every rate limit off. Only for automated tests; never in production.
# RATE_LIMIT_DISABLED=true
# Seconds a SOLD / UNSOLD result stays up before the next player comes (default 5)
# RESULT_BREAK_SECONDS=5
